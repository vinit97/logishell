# setup.sh grants machine-wide input injection to one explicitly trusted account.
# logishell access owner UID: @LOGISHELL_UID@
# Keep TAG removal separate: udev's static-node pass treats TAG-= as a tag to add.
SUBSYSTEM=="misc", KERNEL=="uinput", TAG-="uaccess"
SUBSYSTEM=="misc", KERNEL=="uinput", OWNER:="0", GROUP:="logitech", MODE:="0660", OPTIONS+="static_node=uinput"
